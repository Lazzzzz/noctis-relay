# Copy to .env and edit. Never commit .env.

# Published at /v1/info; the current mod displays it after connecting (required).
NOCTIS_OPERATOR_NAME=Example relay
NOCTIS_OPERATOR_CONTACT=relay-admin@example.org

# Address published on the host by docker compose. Keep 127.0.0.1 behind a
# reverse proxy; use 0.0.0.0 only for a temporary plain-HTTP IP test.
NOCTIS_PUBLISH=127.0.0.1
NOCTIS_HOST_PORT=8787
# Public domain for the optional Caddy HTTPS profile.
NOCTIS_DOMAIN=

# Sessions (seconds). Retention 10..120, heartbeat at most half of it.
NOCTIS_RETENTION_SECONDS=30
NOCTIS_HEARTBEAT_SECONDS=10

# Abuse limits, in memory only. A "client network" is one IPv4 address or
# one IPv6 /64; tables only hold keyed fingerprints of it (see PRIVACY.md).
# Rates are per second. For the new limits below, 0 disables the limit.
NOCTIS_REQUEST_RATE=5
NOCTIS_REQUEST_BURST=40
NOCTIS_CREATE_RATE=0.05
NOCTIS_CREATE_BURST=4
# Session creations per IPv4 /24 or IPv6 /48 (address rotation in a block).
NOCTIS_CREATE_PREFIX_RATE=0.5
NOCTIS_CREATE_PREFIX_BURST=24
# Live sessions per client network. Raise it for large NATs (CGNAT, LAN events).
NOCTIS_MAX_SESSIONS_PER_NETWORK=16
# migrate: a session follows the network that uses it (and counts there);
# strict: a session used from another network is refused (401, new session).
NOCTIS_SESSION_BINDING=migrate
# Requests per live session; such requests skip the relay-wide budget below.
NOCTIS_SESSION_REQUEST_RATE=2
NOCTIS_SESSION_REQUEST_BURST=20
# Relay-wide budgets shared by all clients (answer 503 overloaded when empty).
# The request budget only covers requests without a live session token.
NOCTIS_GLOBAL_REQUEST_RATE=2000
NOCTIS_GLOBAL_REQUEST_BURST=4000
NOCTIS_GLOBAL_CREATE_RATE=50
NOCTIS_GLOBAL_CREATE_BURST=500
NOCTIS_GLOBAL_PRESENCE_RATE=1000
NOCTIS_GLOBAL_PRESENCE_BURST=2000
NOCTIS_MAX_SESSIONS=10000
NOCTIS_MAX_CONNECTIONS=512
# Open sockets per directly connected network (trusted proxies are exempt)
# and requests in progress per real client network (also behind a proxy).
NOCTIS_MAX_CONNECTIONS_PER_PEER=32
NOCTIS_MAX_INFLIGHT_PER_CLIENT=8
NOCTIS_MAX_BODY_BYTES=1024

# Operator block list (403, or reset for direct peers): CIDRs or addresses,
# separated by commas/spaces. NOCTIS_DENY_FILE is one entry per line with
# # comments, re-read on SIGHUP without dropping sessions.
NOCTIS_DENY_NETWORKS=
NOCTIS_DENY_FILE=

# Trust X-Forwarded-For only from these proxies (outside docker compose).
# compose.yaml overrides both to trust only its own Caddy container.
NOCTIS_TRUST_PROXY=0
NOCTIS_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Experimental presence capability (off by default, see PROTOCOL.md).
NOCTIS_PRESENCE=0
NOCTIS_PRESENCE_MIN_INTERVAL=1
NOCTIS_NEAR_RADIUS=48
NOCTIS_NEAR_VERTICAL=12
NOCTIS_NEAR_LIMIT=8
# Live positions per spatial cell (32x32x16 blocks); bounds dense-zone cost.
NOCTIS_PRESENCE_MAX_PER_CELL=64

# Echoes capability (off by default, see PROTOCOL.md and PRIVACY.md): opted-in
# players upload short movement clips (account UUID, position, <= 6 s of
# movement, <= 8 block actions) that nearby players of other games replay.
# Enabling it changes the data you handle: publish your own notice first.
NOCTIS_ECHOES=0
# Separate chat sub-capability (needs NOCTIS_ECHOES=1): <= 2 lines of <= 64
# characters per clip, only from players who opted in to chat.
NOCTIS_ECHO_CHAT=0
# Seconds a clip stays available (10..120); it is also replaced by the next
# clip of the same session and removed when the session ends.
NOCTIS_ECHO_TTL=60
# Lookup area around the requesting player, in blocks.
NOCTIS_ECHO_RADIUS=48
NOCTIS_ECHO_VERTICAL=16
# Live clips per spatial cell (0 = off); a full cell answers 503 area_full.
NOCTIS_ECHO_MAX_PER_CELL=32
# Largest clip upload (1024..16384); other routes keep NOCTIS_MAX_BODY_BYTES.
NOCTIS_ECHO_MAX_BODY_BYTES=6144
# Minimum seconds between two uploads / two lookups of one session (429).
NOCTIS_ECHO_PUBLISH_INTERVAL=20
NOCTIS_ECHO_FETCH_INTERVAL=20
# Fastest accepted movement inside a clip, in blocks per tick.
NOCTIS_ECHO_MAX_SPEED=1.2
NOCTIS_ECHO_MAX_VERTICAL_SPEED=4.0
# Relay-wide budget of echo uploads and lookups (503 overloaded when empty).
NOCTIS_GLOBAL_ECHO_RATE=200
NOCTIS_GLOBAL_ECHO_BURST=400
